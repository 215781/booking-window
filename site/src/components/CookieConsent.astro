---
// Analytics cookies only after an explicit yes (UK PECR). Reject is as easy as accept.
const GA_ID = 'G-G2RES5DX0K';
---
<div class="cookie" id="cookie" hidden role="dialog" aria-live="polite" aria-label="Cookie choice">
  <p>Can we use analytics cookies to see which pages are useful? No advertising cookies, ever.</p>
  <div class="cookie-actions">
    <button type="button" class="btn btn-quiet" data-choice="no">No thanks</button>
    <button type="button" class="btn" data-choice="yes">That's fine</button>
  </div>
</div>
<script is:inline define:vars={{ GA_ID }}>
  (function () {
    var KEY = 'wtb-consent';
    function read() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
    function save(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }
    function loadGA() {
      if (window.__gaLoaded) return; window.__gaLoaded = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { dataLayer.push(arguments); };
      gtag('js', new Date());
      gtag('config', GA_ID, { anonymize_ip: true });
      setTimeout(function () { window.__wtbPageView && window.__wtbPageView(); }, 0);
      var s = document.createElement('script'); s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID; document.head.appendChild(s);
    }
    var box = document.getElementById('cookie');
    var choice = read();
    if (choice === 'yes') loadGA(); else if (!choice) box.hidden = false;
    box.addEventListener('click', function (e) {
      var v = e.target && e.target.getAttribute('data-choice'); if (!v) return;
      save(v); box.hidden = true; if (v === 'yes') loadGA();
    });
    document.querySelectorAll('[data-cookie-settings]').forEach(function (b) {
      b.addEventListener('click', function () { box.hidden = false; });
    });
    // ---- Event tracking (only sent once analytics are accepted) ----
    function send(name, params) { if (window.gtag) window.gtag('event', name, params); }
    function pageContext() {
      var p = document.querySelector('[data-page-resort]');
      return p ? { page_resort: p.getAttribute('data-page-resort'), page_brand: p.getAttribute('data-page-brand') } : {};
    }
    var OPERATORS = { 'clubmed.co.uk': 'Club Med', 'markwarner.co.uk': 'Mark Warner', 'sandals.co.uk': 'Sandals', 'ikosresorts.com': 'Ikos' };
    document.addEventListener('click', function (e) {
      var el = e.target.closest && e.target.closest('a,[data-track]');
      if (!el) return;
      var ctx = pageContext();
      var name = el.getAttribute('data-track');
      var host = el.hostname || '';
      var operator = Object.keys(OPERATORS).find(function (h) { return host === h || host.endsWith('.' + h); });
      if (operator && name !== 'outbound_click') name = 'outbound_click';
      if (!name) return;
      send(name, {
        resort: el.getAttribute('data-resort') || ctx.page_resort || '',
        brand: el.getAttribute('data-brand') || (operator ? OPERATORS[operator] : '') || ctx.page_brand || '',
        collection: el.getAttribute('data-collection') || '',
        click_location: el.getAttribute('data-location') || '',
        link_url: el.href || '',
        outbound: !!operator,
      });
    });
    document.addEventListener('toggle', function (e) {
      var d = e.target;
      if (d.matches && d.matches('details[data-track-toggle]') && d.open) send('open_all_departures', { resort: d.getAttribute('data-resort') || '' });
    }, true);
    window.__wtbPageView = function () {
      var ctx = pageContext();
      if (ctx.page_resort) send('view_resort', { resort: ctx.page_resort, brand: ctx.page_brand });
    };
  })();
</script>
