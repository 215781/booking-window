---
// Small server-rendered price line. Real collected points only.
interface Props { points: { d: string; p: number }[]; label: string }
const { points, label } = Astro.props;
const W = 320, H = 84, P = 8;
const ps = points.map((x) => x.p);
const lo = Math.min(...ps), hi = Math.max(...ps);
const span = hi - lo || 1;
const xy = points.map((x, i) => [
  P + (i * (W - 2 * P)) / Math.max(points.length - 1, 1),
  hi === lo ? H / 2 : P + ((hi - x.p) * (H - 2 * P)) / span,
]);
const d = xy.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join('');
const last = xy.at(-1)!;
---
{points.length > 1 && (
  <svg class="spark" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label}>
    <path d={d} fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
    <circle cx={last[0]} cy={last[1]} r="3.5" fill="currentColor" />
  </svg>
)}
