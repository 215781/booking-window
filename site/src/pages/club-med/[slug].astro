---
import Base from '../../layouts/Base.astro';
import Signup from '../../components/Signup.astro';
import Sparkline from '../../components/Sparkline.astro';
import Trend from '../../components/Trend.astro';
import { RESORTS } from '../../lib/resorts';
import { resortData, dep, schoolWeeks, FAMILY, COUPLE, money, niceDate, weekRange, TREND, changeText, changeShort } from '../../lib/data';

export function getStaticPaths() {
  return RESORTS.map((r) => ({ params: { slug: r.slug }, props: { resort: r } }));
}
const { resort } = Astro.props;
const rd = resortData(resort);
const updated = rd?.updated ?? '';
const feature = schoolWeeks.find((w) => w.key === 'february-half-term')!;
const f = dep(resort, FAMILY, feature.date);
const allFamily = rd?.parties[FAMILY] ?? [];
const title = `When to book ${resort.fullName}: school-holiday prices, updated daily`;
const answer = f?.available
  ? `For February half-term 2027, a family of four at ${resort.fullName} costs ${money(f.price)} for 7 nights (no flights), checked ${niceDate(updated)}. ${changeText(f)}. ${TREND[f.trend ?? 'steady'].line}.`
  : `February half-term 2027 at ${resort.fullName} is not currently bookable online (checked ${niceDate(updated)}).`;
const cheapestWeek = allFamily.filter((d) => d.available).sort((a, b) => a.price! - b.price!)[0];
const faqs = [
  { q: `When is the best time to book ${resort.fullName}?`, a: `${answer} Outside school holidays, the lowest price we're currently seeing for a family of four is ${money(cheapestWeek?.price)} for the week of ${cheapestWeek ? niceDate(cheapestWeek.date) : '-'}.` },
  { q: `How much does ${resort.fullName} cost for a family of four?`, a: `Across the 2026/27 season we're currently seeing ${money(Math.min(...allFamily.filter(d=>d.available).map(d=>d.price!)))} to ${money(Math.max(...allFamily.filter(d=>d.available).map(d=>d.price!)))} for 7 nights, 2 adults and 2 children aged 4-11, all-inclusive, without flights.` },
  { q: 'Do these prices include flights?', a: 'No. We track the Club Med package without flights, so the comparison stays like-for-like. Club Med prices include accommodation, meals, drinks, lift pass and ski or snowboard lessons.' },
  { q: 'Is this a forecast?', a: 'No. We show what prices have actually done, based on checks every morning. Past movement is a useful guide, but prices can change at any time.' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Resort', name: resort.fullName, url: new URL(`/club-med/${resort.slug}/`, Astro.site).href, image: new URL(`/images/${resort.image}.jpg`, Astro.site).href, address: { '@type': 'PostalAddress', addressCountry: 'FR', addressRegion: resort.area } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', dateModified: updated, mainEntity: faqs.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Club Med ski', item: new URL('/club-med/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: resort.name } ] },
];
---
<Base title={title} description={answer.slice(0, 155)} jsonLd={jsonLd} image={`/images/${resort.image}.jpg`}>
  <div class="hero">
    <img src={`/images/${resort.image}.jpg`} alt={resort.imageAlt} width="1600" height="900" />
    <div class="inner"><div>
      <p class="kicker">Club Med · {resort.area}{resort.altitude && ` · ${resort.altitude}`}</p>
      <h1>When to book {resort.fullName}</h1>
      <p>School-holiday prices for a family of four, checked every morning.</p>
    </div></div>
  </div>
  <div class="wrap narrow">
    <p class="crumbs"><a href="/">Home</a> / <a href="/club-med/">Club Med ski</a> / {resort.name}</p>
    {rd?.stale && <p class="notice">Heads up: our latest check for this resort is from {niceDate(updated)}. We're looking into it.</p>}

    <div class="verdict">
      <p class="kicker">February half-term 2027 · family of 4 · 7 nights</p>
      {f?.available ? (
        <>
          <p class="big">{TREND[f.trend ?? 'steady'].line}</p>
          <p><span class="price">{money(f.price)}</span> <span class="muted">· {changeText(f)}</span></p>
          {f.history && <Sparkline points={f.history} label={`Price history for February half-term at ${resort.name}`} />}
          <p class="small">Checked {niceDate(updated)}. Lowest we've seen {money(f.lowest)}, highest {money(f.highest)}. Guidance only - confirm with Club Med before booking.</p>
        </>
      ) : <><p class="big">Not currently bookable online</p><p class="small">Checked {niceDate(updated)}. This week may be sold out or not yet on sale - check Club Med directly.</p></>}
      <p><a class="btn" href={resort.bookingUrl} rel="nofollow noopener" target="_blank" data-outbound={resort.slug}>See it on Club Med</a></p>
    </div>

    <h2>School holidays at a glance</h2>
    <p class="muted">7 nights from Sunday, 2 adults and 2 children aged 4-11, without flights. Dates follow most schools in England.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Week</th><th>Family of 4</th><th>30 days</th><th>Trend</th><th class="hide-sm">Couple</th></tr></thead>
      <tbody>
        {schoolWeeks.map((w) => { const fd = dep(resort, FAMILY, w.date); const cd = dep(resort, COUPLE, w.date); return (
          <tr><td><strong>{w.label}</strong><br /><span class="small">{weekRange(w.date)}</span></td>
          <td class="num">{fd?.available ? money(fd.price) : '-'}</td>
          <td>{changeShort(fd)}</td>
          <td><Trend trend={fd?.trend} available={fd?.available} /></td>
          <td class="num hide-sm">{cd?.available ? money(cd.price) : '-'}</td></tr>
        ); })}
      </tbody>
    </table></div>

    <Signup heading={`Watch ${resort.name} for me`} text={`We'll email you when ${resort.name} prices move for the school holidays. Free, one click to unsubscribe.`} interest={resort.slug} />

    <details>
      <summary>Every departure week this season (family of 4)</summary>
      <div class="table-wrap"><table>
        <thead><tr><th>Week</th><th>Price</th><th>30 days</th><th class="hide-sm">Lowest seen</th></tr></thead>
        <tbody>{allFamily.map((d) => (
          <tr><td>{weekRange(d.date)}</td><td class="num">{d.available ? money(d.price) : '-'}</td><td>{changeShort(d)}</td><td class="hide-sm">{money(d.lowest)}</td></tr>
        ))}</tbody>
      </table></div>
    </details>

    <section class="faq">
      <h2>Questions</h2>
      {faqs.map((x) => (<><h3>{x.q}</h3><p>{x.a}</p></>))}
    </section>
    {resort.blog && <p>Read more: <a href={`/blog/${resort.blog}/`}>our full guide to booking {resort.name}</a>.</p>}
  </div>
</Base>
