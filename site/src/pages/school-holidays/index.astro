---
import Base from '../../layouts/Base.astro';
import Trend from '../../components/Trend.astro';
import Signup from '../../components/Signup.astro';
import { SKI, SUN, MARKWARNER, COLLECTIONS } from '../../lib/resorts';
import { WEEKS, weekDep, hasData, FAMILY, money, weekRange, changeShort, latestUpdate, niceDate } from '../../lib/data';
const updated = latestUpdate();
const sections = [
  { id: 'ski', title: 'Ski holidays 2026/27', resorts: SKI, weeks: WEEKS.ski },
  { id: 'sun', title: 'Sun holidays 2026/27', resorts: [...SUN, ...MARKWARNER].filter(hasData), weeks: WEEKS.sun },
];
---
<Base title="School holiday prices 2026/27: Club Med and Mark Warner by week" description="Christmas, half-terms, Easter and summer 2027 prices for a family of four at Club Med and Mark Warner, checked every morning.">
  <div class="wrap narrow">
    <p class="crumbs"><a href="/">Home</a> / School holidays</p>
    <h1>School-holiday prices, week by week</h1>
    <p class="muted">Family of four (2 children aged 4-11), 7 nights. Club Med prices exclude flights; Mark Warner prices include flights from London Gatwick. Sorted by price. Checked {niceDate(updated)}. Dates follow most schools in England - check your own school's calendar.</p>
    <p class="small">Jump to: {sections.flatMap((s) => s.weeks.map((w) => <a href={`#${s.id}-${w.key}`}>{w.label}</a>)).reduce((a: any[], x, i) => (i ? [...a, ' · ', x] : [x]), [])}</p>
    {sections.map((s) => (<>
      <h2 id={s.id}>{s.title}</h2>
      {s.weeks.map((w) => {
        const rows = s.resorts.map((r) => ({ r, d: weekDep(r, FAMILY, w) })).filter((x) => x.d)
          .sort((a, b) => (a.d?.available ? a.d.price! : 1e9) - (b.d?.available ? b.d.price! : 1e9));
        return (<section id={`${s.id}-${w.key}`}>
          <h3>{w.label}</h3>
          {rows.length === 0 ? <p class="muted">No departures tracked for this week yet.</p> : (
          <div class="table-wrap"><table>
            <thead><tr><th>Resort</th><th>Family of 4</th><th>30 days</th><th>Trend</th></tr></thead>
            <tbody>{rows.map(({ r, d }) => (<tr>
              <td><a href={`${COLLECTIONS[r.collection].base}${r.slug}/`} data-track="select_resort" data-resort={r.slug} data-brand={COLLECTIONS[r.collection].brand} data-location={`school-${w.key}`}>{r.name}</a><br /><span class="small">{COLLECTIONS[r.collection].brand} · {weekRange(d!.date)}</span></td>
              <td class="num">{d?.available ? money(d.price) : '-'}</td><td>{changeShort(d)}</td><td><Trend trend={d?.trend} available={d?.available} /></td></tr>))}</tbody>
          </table></div>)}
        </section>);
      })}
    </>))}
    <Signup heading="Get school-holiday price alerts" interest="school-holidays" />
  </div>
</Base>
